{
  "name": "@kikiutils/eslint-config",
  "type": "module",
  "version": "9.2.1",
  "description": "Using antfu/eslint-config as a base for eslint-config, slightly modified the settings and added additional plugins, mainly for my own use.",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikiutils/eslint-config.git"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    "./internals/plugins": {
      "types": null,
      "import": null,
      "require": null
    },
    "./internals/rules/compact-iteration-layout": {
      "types": null,
      "import": null,
      "require": null
    },
    "./internals/rules/consistent-condition-layout": {
      "types": null,
      "import": null,
      "require": null
    },
    "./internals/rules/consistent-parameter-layout": {
      "types": null,
      "import": null,
      "require": null
    },
    "./internals/utils": {
      "types": null,
      "import": null,
      "require": null
    },
    "./package.json": "./package.json",
    "./*": "./dist/*.js"
  },
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint/css": "^2.0.0",
    "@html-eslint/parser": ">=0.65.0",
    "@kikiutils/eslint-plugin-vue": "^10.10.0",
    "eslint": ">=9.0.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-format": ">=2.0.1",
    "tailwind-csstree": "^0.4.0",
    "tailwindcss": ">=4.3.3",
    "vue-eslint-parser": "^10.4.1"
  },
  "peerDependenciesMeta": {
    "@eslint/css": {
      "optional": true
    },
    "@html-eslint/parser": {
      "optional": true
    },
    "@kikiutils/eslint-plugin-vue": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    },
    "eslint-plugin-format": {
      "optional": true
    },
    "tailwind-csstree": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "dependencies": {
    "eslint-plugin-promise": "^7.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@kikiutils/eslint-config": "^9.2.1",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "changelogen": "^0.6.2",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-format": "^2.0.1",
    "knip": "^6.39.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.6.0",
    "vitest": "^5.0.3"
  }
}
