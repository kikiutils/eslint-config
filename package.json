{
  "name": "@kikiutils/eslint-config",
  "type": "module",
  "version": "11.0.0",
  "description": "Using antfu/eslint-config as a base for eslint-config, slightly modified the settings and added additional plugins, mainly for my own use.",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikiutils/eslint-config.git"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    "./base": "./dist/base.js",
    "./style": "./dist/style.js",
    "./vue": "./dist/vue.js",
    "./package.json": "./package.json"
  },
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "ts-extras": "^2.0.0",
    "type-fest": "^5.10.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/css": "^2.0.1",
    "@html-eslint/parser": "^0.67.0",
    "@kikiutils/eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-typefest": "^1.5.1",
    "tailwind-csstree": "^0.4.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@arethetypeswrong/core": "^0.18.5",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.14.0",
    "knip": "^6.44.1",
    "publint": "^0.3.25",
    "ts-extras": "^2.0.0",
    "tsdown": "^0.23.7",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.6.0",
    "vitest": "^5.1.0"
  }
}
